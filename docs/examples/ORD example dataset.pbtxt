# proto-file: ord-schema/proto/dataset.proto
# proto-message: ord.Dataset
name: "Chemistry Lab Notebook examples"
description: "Example reactions IM_00, IM_1 and IM_2 of the vault, exported by Reaction Structure Search 1.9.8. Stereochemistry is taken from the wedge bonds and double-bond geometry of the reaction drawings; the details of each SMILES identifier say how it is meant: absolute configuration as drawn, a racemic mixture (rac-, ±), or relative configuration with the absolute configuration unknown (rel-). Unspecified stereocentres are left undefined."
reactions {
  inputs {
    key: "C13H8O"
    value {
      components {
        identifiers {
          type: SMILES
          value: "O=C1c2ccccc2-c2ccccc21"
        }
        amount {
          mass {
            value: 1.5
            units: GRAM
          }
        }
        reaction_role: REACTANT
        is_limiting: true
      }
    }
  }
  inputs {
    key: "C14H14O2P2S4"
    value {
      components {
        identifiers {
          type: SMILES
          value: "COc1ccc(P2(=S)SP(=S)(c3ccc(OC)cc3)S2)cc1"
        }
        amount {
          mass {
            value: 1.68
            units: GRAM
          }
        }
        reaction_role: UNSPECIFIED
      }
    }
  }
  inputs {
    key: "toluene"
    value {
      components {
        identifiers {
          type: SMILES
          value: "Cc1ccccc1"
        }
        identifiers {
          type: NAME
          value: "toluene"
        }
        amount {
          volume {
            value: 300
            units: MILLILITER
          }
        }
        reaction_role: SOLVENT
        features {
          key: "mass"
          value {
            string_value: "260.10 g"
            description: "from the reagent table"
          }
        }
      }
    }
  }
  conditions {
    temperature {
      control {
        type: CUSTOM
        details: "reflux"
      }
    }
    reflux: true
    pressure {
      atmosphere {
        type: AIR
      }
    }
  }
  notes {
    procedure_details: "To a solution of fluorenone  in toluene was added, Lawesson’s reagent. The mixture was refluxed overnight. The solution was concentrated under reduced pressure. The resulting mixture was extracted with ethyl acetate/brine, and then dried with anhydrous MgSO4. The residue product was purified by column chromatography using hexane/DCM 70/30 as the eluents. The resulting solid was recrystallized in dichloromethane and methanol, and then the orange needles were dried in vacuo."
  }
  outcomes {
    products {
      identifiers {
        type: SMILES
        value: "c1ccc2c(c1)C(=C1c3ccccc3-c3ccccc31)c1ccccc1-2"
      }
      is_desired_product: true
      reaction_role: PRODUCT
      measurements {
        type: YIELD
        analysis_key: "isolated"
        percentage {
          value: 57
        }
      }
      measurements {
        type: AMOUNT
        analysis_key: "isolated"
        amount {
          mass {
            value: 775
            units: MILLIGRAM
          }
        }
      }
      measurements {
        type: IDENTITY
        analysis_key: "1H NMR"
      }
      measurements {
        type: IDENTITY
        analysis_key: "13C NMR"
      }
      measurements {
        type: IDENTITY
        analysis_key: "HRMS"
      }
    }
    reaction_time {
      value: 12
      units: HOUR
    }
    analyses {
      key: "1H NMR"
      value {
        type: NMR_1H
        details: "300 MHz (1H), CDCl3"
        data {
          key: "text"
          value {
            string_value: "8.41 (d, 4H), 7.87 (d, 4H), 7.40 (t, 4H), 7.31 (t, 4H)"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "13C NMR"
      value {
        type: NMR_13C
        details: "300 MHz (1H), CDCl3"
        data {
          key: "text"
          value {
            string_value: "142.0, 141.2, 138.9, 129.4, 127.5, 127.1, 120.8"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "HRMS"
      value {
        type: HRMS
        details: "APCI"
        data {
          key: "text"
          value {
            string_value: "[M+H]+ calcd for C26H17+ 329.1325, found; 329.1328"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "isolated"
      value {
        type: WEIGHT
        details: "isolated product"
        is_of_isolated_species: true
      }
    }
  }
  provenance {
    experimenter {
      name: "Example Author"
    }
    record_created {
      time {
        value: "2026-10-22T12:00:00"
      }
      person {
        name: "Example Author"
        email: "author@example.org"
      }
    }
    experiment_start {
      value: "2025-02-09"
    }
  }
}
reactions {
  inputs {
    key: "C24H16Cl2F6N3P"
    value {
      components {
        identifiers {
          type: SMILES
          value: "Clc1ccc(N2N=[N+](c3ccc(Cl)cc3)C3c4cccc5cccc(c45)C32)cc1.F[P-](F)(F)(F)(F)F"
        }
        amount {
          mass {
            value: 112.46
            units: MILLIGRAM
          }
        }
        reaction_role: REACTANT
        is_limiting: true
      }
    }
  }
  inputs {
    key: "THF"
    value {
      components {
        identifiers {
          type: SMILES
          value: "C1CCOC1"
        }
        identifiers {
          type: NAME
          value: "THF"
        }
        amount {
          volume {
            value: 4
            units: MILLILITER
          }
        }
        reaction_role: SOLVENT
      }
    }
  }
  inputs {
    key: "MeMgBr"
    value {
      components {
        identifiers {
          type: SMILES
          value: "[CH3][Mg][Br]"
          details: "from the name written in the scheme, via the plugin's list of common reagents"
        }
        identifiers {
          type: NAME
          value: "MeMgBr"
        }
        amount {
          moles {
            value: 200.01
            units: MICROMOLE
          }
        }
        reaction_role: REACTANT
        features {
          key: "mass"
          value {
            string_value: "23.85 mg"
            description: "from the reagent table"
          }
        }
        features {
          key: "volume"
          value {
            string_value: "66.67 µL"
            description: "from the reagent table"
          }
        }
        features {
          key: "concentration"
          value {
            string_value: "3.00 M"
            description: "molarity, from the reagent table"
          }
        }
      }
    }
  }
  conditions {
    temperature {
      control {
        type: CUSTOM
        details: "-10 to rt"
      }
    }
    pressure {
      atmosphere {
        type: NITROGEN
      }
    }
  }
  notes {
    procedure_details: "In the nitrogen atmosphere glove box, the oven dried vial was charged with nitrenium salt **3** (0.2 mmol, 1 eq). THF (0.05 M, 4 ml) was added, and the suspension was cooled down to -10 °C with cooling aluminum block. MeMgBr (1 eq, 3 M, 0.067 ml) was added dropwise to the nitrenium suspension with stirring, and the reaction mixture was allowed to reach room temperature overnight. The mixture was filtered through a cotton pad, and the precipitate was washed with THF (2 ml). Anhydrous citric acid (1.5 eq, 58 mg) was added in one portion to the reaction mixture, and it was stirred at room temperature upon completion. The reaction was quenched with aqueous NaHCO3 (sat, 10 ml) and EtOAc (40 ml) was added to extract all the organic materials. Organic phase was separated and washed with aqueous NaHCO3 (sat, 2x10 ml) and brine (10 ml). The organic phase was passed through a pad of Na2SO4 for additional drying and evaporated. Et2O (1-2 ml) was added to the remaining oil and resulting solution/suspension was subjected to flash filtration through neutral aluminum oxide with the eluent specified, and that afforded pure compound **4**. The yield of the reaction is calculated for the two-step sequence"
  }
  workups {
    type: ADDITION
    input {
      components {
        identifiers {
          type: SMILES
          value: "O=C(O)CC(O)(CC(=O)O)C(=O)O"
        }
        amount {
          mass {
            value: 57.64
            units: MILLIGRAM
          }
        }
        reaction_role: WORKUP
      }
    }
  }
  workups {
    type: CUSTOM
    details: "flash filtration through neutral aluminum oxide; eluent: EtOAc/hexane, from 1:10 to 1:6"
  }
  outcomes {
    products {
      identifiers {
        type: SMILES
        value: "Clc1ccc(N2CNN(c3ccc(Cl)cc3)[C@@H]3c4cccc5cccc(c45)[C@@H]32)cc1"
        details: "racemic mixture: the drawn stereocentres give the relative configuration"
      }
      identifiers {
        type: NAME
        value: "(6bSR,10aRS)-7,10-bis(4-chlorophenyl)-6b,7,8,9,10,10a-hexahydroacenaphtho[1,2-e][1,2,4]triazine"
      }
      is_desired_product: true
      reaction_role: PRODUCT
      measurements {
        type: YIELD
        analysis_key: "isolated"
        percentage {
          value: 82
        }
      }
      measurements {
        type: AMOUNT
        analysis_key: "isolated"
        amount {
          mass {
            value: 71
            units: MILLIGRAM
          }
        }
      }
      measurements {
        type: IDENTITY
        analysis_key: "1H NMR"
      }
      measurements {
        type: IDENTITY
        analysis_key: "13C NMR"
      }
      measurements {
        type: IDENTITY
        analysis_key: "HRMS"
      }
      isolated_color: "pale yellow"
      texture {
        type: SOLID
      }
    }
    analyses {
      key: "1H NMR"
      value {
        type: NMR_1H
        details: "500 MHz (1H), DMSO-d6"
        data {
          key: "text"
          value {
            string_value: "7.84-7.83 (m, 1H), 7.79-7.78 (m, 1H), 7.51-7.48 (m, 2H), 7.30-7.21 (m, 8H), 7.09-7.07 (m, 2H), 6.52 (d, J = 7.7 Hz, 1H), 6.17 (d, J = 7.7 Hz, 1H), 4.52-4.48 (m, 1H), 4.12-4.06 (m, 2H)"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "13C NMR"
      value {
        type: NMR_13C
        details: "500 MHz (1H), DMSO-d6"
        data {
          key: "text"
          value {
            string_value: "148.2, 147.6, 143.0, 140.3, 138.3, 131.2, 129.4, 129.1, 128.7 (2C), 125.4, 124.5, 122.2, 121.7 (2C), 120.6, 115.7, 115.6, 62.1, 61.9, 56.2"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "HRMS"
      value {
        type: HRMS
        details: "APCI"
        data {
          key: "text"
          value {
            string_value: "[M+H]+ calcd for C25H2035Cl2N3+ 432.1029; found 432.1053"
          }
        }
        is_of_isolated_species: true
      }
    }
    analyses {
      key: "isolated"
      value {
        type: WEIGHT
        details: "isolated product"
        is_of_isolated_species: true
      }
    }
  }
  provenance {
    experimenter {
      name: "Example Author"
    }
    record_created {
      time {
        value: "2026-10-22T12:00:00"
      }
      person {
        name: "Example Author"
        email: "author@example.org"
      }
    }
    experiment_start {
      value: "2026-03-30"
    }
  }
}
